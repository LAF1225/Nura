# Normalise line endings so the repository is identical on Windows and macOS.
# iOS work happens on a Mac while day-to-day development here is on Windows,
# so without this every file would churn when moving between them.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets must never be line-ending converted.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.hbc  binary
*.jks  binary
*.p12  binary
*.keystore binary
