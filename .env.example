# ===========================================================================
# Nura -- environment variable template (PRD 0, section 18)
#
# Copy the relevant section into a real .env file and fill in the values.
# Never commit a filled-in .env; .gitignore already excludes them.
#
#   mobile/.env    <- the EXPO_PUBLIC_* block below
#   backend/.env   <- the backend block below
# ===========================================================================


# ---------------------------------------------------------------------------
# MOBILE -- PUBLIC values only.
#
# Expo inlines every EXPO_PUBLIC_* variable into the app bundle, so anyone
# with the app can read them. Never put a secret, private key or database
# password in this section.
# ---------------------------------------------------------------------------

# Base URL of the Nura API, with no trailing slash.
# Leave blank during local development: the app derives the address from the
# Expo dev server's host and port 8000, which is what lets a physical phone
# reach your machine without editing an IP by hand.
# Release builds must set this to an HTTPS URL.
EXPO_PUBLIC_API_URL=


# ---------------------------------------------------------------------------
# BACKEND -- PRIVATE values. These stay on the server and are never shipped
# to the app.
# ---------------------------------------------------------------------------

# SQLAlchemy connection URL. Required; the backend will not start without it.
# Local PostgreSQL:
#   postgresql+psycopg://nura:CHANGE_ME@localhost:5432/nura_dev
# Supabase-hosted PostgreSQL (use the connection string from the dashboard):
#   postgresql+psycopg://postgres:CHANGE_ME@db.<project>.supabase.co:5432/postgres
DATABASE_URL=

# `development` or `production`. Controls log level and CORS behaviour.
APP_ENV=development

# Secret used to verify authentication tokens. Not used in PRD 0; required
# from PRD 1 onward. Generate a long random value -- do not invent a short one.
JWT_SECRET=


# ---------------------------------------------------------------------------
# SUPABASE (optional in PRD 0)
#
# Authentication is implemented in PRD 1. These are listed now so the names
# are settled. SUPABASE_ANON_KEY is designed to be public and belongs in the
# mobile app as EXPO_PUBLIC_SUPABASE_ANON_KEY once auth is wired up; the
# service-role key is a server secret and must never reach the app.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
