# ===========================================================================
# Nura -- environment variable template (PRD 0 section 18; PRD 1 section 52)
#
# Copy the relevant section into a real .env file and fill in the values.
# Never commit a filled-in .env; .gitignore already excludes them.
#
#   mobile/.env    <- the EXPO_PUBLIC_* block below
#   backend/.env   <- the backend block below
# ===========================================================================


# ---------------------------------------------------------------------------
# MOBILE -- PUBLIC values only.
#
# Expo inlines every EXPO_PUBLIC_* variable into the app bundle, so anyone
# with the app can read them. Never put a secret, private key or database
# password in this section.
# ---------------------------------------------------------------------------

# Base URL of the Nura API, with no trailing slash.
# Leave blank during local development: the app derives the address from the
# Expo dev server's host and port 8000, which is what lets a physical phone
# reach your machine without editing an IP by hand.
# Release builds must set this to an HTTPS URL.
EXPO_PUBLIC_API_URL=

# Supabase project URL, e.g. https://abcdefgh.supabase.co
# Supabase dashboard -> Project Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase "anon" / publishable key. This one is designed to be public and is
# safe in the app bundle: it grants nothing on its own, and row-level security
# plus our own backend are what actually protect data.
# Never put the service_role key here -- that one bypasses every policy.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Google OAuth client id used for Sign in with Google.
# Google Cloud console -> Credentials -> OAuth 2.0 Client IDs (Web client).
# Leave blank and the Google button reports itself as not configured rather
# than pretending to work.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=


# ---------------------------------------------------------------------------
# BACKEND -- PRIVATE values. These stay on the server and are never shipped
# to the app.
# ---------------------------------------------------------------------------

# SQLAlchemy connection URL. Required; the backend will not start without it.
# Local PostgreSQL:
#   postgresql+psycopg://nura:CHANGE_ME@localhost:5432/nura_dev
# Supabase-hosted PostgreSQL (use the connection string from the dashboard):
#   postgresql+psycopg://postgres:CHANGE_ME@db.<project>.supabase.co:5432/postgres
DATABASE_URL=

# `development` or `production`. Controls log level and CORS behaviour.
APP_ENV=development

# Supabase project URL -- the same value as EXPO_PUBLIC_SUPABASE_URL above.
# The backend derives the token issuer and the public JWKS endpoint from it,
# which is all it needs to verify access tokens. Not a secret.
# Leave blank and protected routes answer 503 "auth not configured" rather
# than letting anything through.
SUPABASE_URL=

# Optional, and usually leave this blank.
# Only needed for older Supabase projects that still sign tokens with a shared
# HS256 secret. New projects use asymmetric keys, which the backend verifies
# through the public JWKS endpoint with no shared secret at all.
# Supabase dashboard -> Project Settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=

# Reserved for tokens Nura itself might issue in a later stage. Unused today:
# authentication tokens come from Supabase and are verified with the keys
# above. Generate a long random value if a later PRD needs it.
JWT_SECRET=

# Where a robot should reach this API once it is on Wi-Fi. Handed to the robot
# during pairing, so it must be an address the robot can resolve -- not
# localhost, which would be the robot itself.
# In development, leave blank: the backend hands the robot the same LAN address
# the phone used to reach it, which works because both are on your Wi-Fi.
# Required in production, and must be https there.
DEVICE_API_BASE_URL=
