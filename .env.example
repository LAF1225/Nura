# ===========================================================================
# Nura -- environment variable template (PRD 0 section 18; PRD 1 section 52)
#
# Copy the relevant section into a real .env file and fill in the values.
# Never commit a filled-in .env; .gitignore already excludes them.
#
#   mobile/.env    <- the EXPO_PUBLIC_* block below
#   backend/.env   <- the backend block below
# ===========================================================================


# ---------------------------------------------------------------------------
# MOBILE -- PUBLIC values only.
#
# Expo inlines every EXPO_PUBLIC_* variable into the app bundle, so anyone
# with the app can read them. Never put a secret, private key or database
# password in this section.
# ---------------------------------------------------------------------------

# Base URL of the Nura API, with no trailing slash.
# Leave blank during local development: the app derives the address from the
# Expo dev server's host and port 8000, which is what lets a physical phone
# reach your machine without editing an IP by hand.
# Release builds must set this to an HTTPS URL.
EXPO_PUBLIC_API_URL=

# Supabase project URL, e.g. https://abcdefgh.supabase.co
# Supabase dashboard -> Project Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase "anon" / publishable key. This one is designed to be public and is
# safe in the app bundle: it grants nothing on its own, and row-level security
# plus our own backend are what actually protect data.
# Never put the service_role key here -- that one bypasses every policy.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Google OAuth client id used for Sign in with Google.
# Google Cloud console -> Credentials -> OAuth 2.0 Client IDs (Web client).
# Leave blank and the Google button reports itself as not configured rather
# than pretending to work.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=


# ---------------------------------------------------------------------------
# BACKEND -- PRIVATE values. These stay on the server and are never shipped
# to the app.
# ---------------------------------------------------------------------------

# SQLAlchemy connection URL. Required; the backend will not start without it.
# Local PostgreSQL:
#   postgresql+psycopg://nura:CHANGE_ME@localhost:5432/nura_dev
# Supabase-hosted PostgreSQL (use the connection string from the dashboard):
#   postgresql+psycopg://postgres:CHANGE_ME@db.<project>.supabase.co:5432/postgres
DATABASE_URL=

# `development` or `production`. Controls log level and CORS behaviour.
APP_ENV=development

# Supabase project URL -- the same value as EXPO_PUBLIC_SUPABASE_URL above.
# The backend derives the token issuer and the public JWKS endpoint from it,
# which is all it needs to verify access tokens. Not a secret.
# Leave blank and protected routes answer 503 "auth not configured" rather
# than letting anything through.
SUPABASE_URL=

# Optional, and usually leave this blank.
# Only needed for older Supabase projects that still sign tokens with a shared
# HS256 secret. New projects use asymmetric keys, which the backend verifies
# through the public JWKS endpoint with no shared secret at all.
# Supabase dashboard -> Project Settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=

# Reserved for tokens Nura itself might issue in a later stage. Unused today:
# authentication tokens come from Supabase and are verified with the keys
# above. Generate a long random value if a later PRD needs it.
JWT_SECRET=

# Where a robot should reach this API once it is on Wi-Fi. Handed to the robot
# during pairing, so it must be an address the robot can resolve -- not
# localhost, which would be the robot itself.
# In development, leave blank: the backend hands the robot the same LAN address
# the phone used to reach it, which works because both are on your Wi-Fi.
# Required in production, and must be https there.
DEVICE_API_BASE_URL=

# Optional. A TrueType font to embed in generated doctor-summary PDFs, so a
# report can carry any script. Relative paths resolve against `backend/`.
# Left blank, reports are typeset in the PDF standard Helvetica, which covers
# Latin-1 only: typographic punctuation is folded to ASCII and anything else
# becomes "?". Setting this is the whole fix; no code changes with it.
# A sibling file named <stem>-Bold<suffix> is used for bold if it is there.
REPORT_FONT_PATH=

# --- the Nura assistant (PRD 8) ---------------------------------------------
# All server-side. None of these is ever sent to the app: the app talks to this
# backend, and this backend talks to the model provider. A provider key in a
# mobile build is a key in every user's hands, which is why there is no
# EXPO_PUBLIC_ equivalent of anything below.

# Which model provider to use. `anthropic` is the real one. `scripted` replays
# canned replies for development and tests, and is refused outside development.
# Leave blank and the Nura tab says the assistant is not set up on this server,
# rather than failing one message at a time.
AI_PROVIDER=

# The model to ask. Changing it is a deployment decision, not a code change.
# Defaults to claude-opus-5 when left blank.
AI_MODEL=

# The provider credential. **Secret.** Never commit a real value, and never
# put it anywhere the app can read it.
AI_API_KEY=

# How long one model request may take before the user is told Nura cannot
# answer right now. Defaults to 45 seconds.
AI_TIMEOUT_SECONDS=

# Ceiling on a single reply, in tokens. Defaults to 1500 -- conversational
# rather than essay-length, because this is a chat window on a phone.
AI_MAX_OUTPUT_TOKENS=

# How hard the model works per reply: low, medium, high, xhigh or max.
# Defaults to low, which suits a chat assistant whose safety behaviour is
# enforced by deterministic policy rather than by model judgement.
AI_EFFORT=

# Whether to ask the provider to re-route a request its own safety layer
# declines, rather than returning nothing. Defaults to true. Set to false if
# the account serving this deployment cannot use that feature.
AI_SERVER_SIDE_FALLBACK=

# How many assistant messages one profile may send per hour. Defaults to 60.
ASSISTANT_RATE_LIMIT_PER_HOUR=

# Whether to log the *shape* of model requests -- token counts, latency, which
# tools ran. Never the conversation itself, at any setting. Off by default.
ASSISTANT_LOG_MODEL_REQUESTS=

# --- Caregivers and family communication (PRD 9) ----------------------------

# Which audio-call provider to use. Unset in every deployment today, and the
# only implementation behind that refuses every call rather than reporting a
# successful one -- PRD 9 section 38 forbids simulating a call that is not
# happening. Wiring a real provider later means a class in
# services/caregivers/calls.py and a branch in build_provider; its credentials
# belong here, server-side, for the same reason the model provider's key does.
AUDIO_CALL_PROVIDER=

# --- Safety monitoring and SOS (PRD 10) -------------------------------------

# Where a safety alert would be delivered, and who would place an emergency
# call. All three are unset in every deployment, and the capability endpoint
# reports "not_configured" because of it rather than because somebody wrote
# that into a screen.
#
# Unset means not configured. A name nobody implemented is refused at startup
# rather than quietly ignored -- a deployment that set SAFETY_SMS_PROVIDER and
# got silence would believe it had SMS. PRD 10 section 109 also forbids
# defaulting production to a fake provider, which is why there is no "mock" or
# "log" value any of these accepts.
#
# SAFETY_CALL_PROVIDER is distinct from AUDIO_CALL_PROVIDER above: that one is
# a two-way call between a primary user and a caregiver who both have the app,
# this one would ring a number belonging to somebody who may have no Nura
# account at all. Configuring one must never be taken to configure the other.
SAFETY_PUSH_PROVIDER=
SAFETY_SMS_PROVIDER=
SAFETY_CALL_PROVIDER=

# --- Daily life: the outside services Nura does not have (PRD 12) -----------

# Who would answer "what is the weather", "what is in the news", and which
# external calendar Nura would read. All three are unset in every deployment,
# and **nothing implements any of them** -- there is no HTTP client, no API key
# and no parser for a forecast, a headline or an external calendar event
# anywhere in this repository. PRD 12 section 12 forbids pretending to reach a
# service unless a real provider exists and the request actually succeeds, and
# the strongest version of that is code with no path to pretend.
#
# Unlike the safety providers above, a name nobody implemented does not stop
# the service starting: it logs a warning and the capability map still reads
# "not_configured", because these are read on every capability check rather
# than built once at boot. Either way a misconfigured deployment gets an honest
# refusal rather than a feature that sometimes answers.
#
# Wiring a real one later means a class with a method, a branch in
# services/productivity/providers.build_provider, and its credentials here,
# server-side (section 74). The capability endpoint, the assistant's system
# prompt and the app's "What Nura can reach" screen all read the same three
# functions and will start saying "available" on their own.
WEATHER_PROVIDER=
NEWS_PROVIDER=
EXTERNAL_CALENDAR_PROVIDER=
