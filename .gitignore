# ---------------------------------------------------------------------------
# Secrets and environment files
# Real credentials must never be committed (PRD 0, section 18).
# `.env.example` is the tracked template; every other .env stays local.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Mobile (Node / Expo)
# ---------------------------------------------------------------------------
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
*.tsbuildinfo

# Native projects are generated by `npx expo prebuild` and are not tracked.
/mobile/ios/
/mobile/android/
.kotlin/
*.orig.*

# Signing material
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ---------------------------------------------------------------------------
# Backend (Python)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Logs and editor / OS noise
# ---------------------------------------------------------------------------
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
Thumbs.db
.idea/
.vscode/
